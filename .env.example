# --- PostgreSQL: local Docker Compose ---
DATABASE_URL=postgresql+asyncpg://sec_agent:dev_only@localhost:5433/sec_agent

# --- SEC EDGAR: replace with your contact email ---
SEC_USER_AGENT=your-email@example.com

# --- Gemini embeddings ---
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Groq chat models ---
GROQ_API_KEY=
PLAN_MODEL=openai/gpt-oss-20b
VALIDATE_MODEL=openai/gpt-oss-120b
REFUSAL_MODEL=openai/gpt-oss-20b
ALLOWED_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

# --- Optional alternative providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
EXPOSE_TRACE_URLS=true

# --- Local API authentication ---
API_KEY=dev-local-key

# --- Clerk backend authentication ---
# Add your Clerk application's values to your private .env.
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=

# --- Local development ---
RATE_LIMIT_PER_MINUTE=60
LANGGRAPH_CHECKPOINTER_ENABLED=false
ASK_TOKEN_LIMITER_ENABLED=false

# --- Anonymous preview ---
ANON_LIFETIME_ENABLED=false
ANON_LIFETIME_LIMIT=10
ANON_HASH_SALT=
ANON_TICKER_ALLOWLIST=AAPL,MSFT,GOOGL,AMZN,NVDA